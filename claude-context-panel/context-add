#!/usr/bin/env bash
# Record a line for the context panel: a reference pin, or an action item.
# Every write appends. Replacing the whole list takes an explicit --set.
#   context-add "#1114 수집기 RPC 타임아웃  https://tracker.example.com/tasks/1114"
#   context-add --add  "초안  /tmp/scratch/draft.md"   # same as no flag, kept for compatibility
#   context-add --todo "배포 반영 확인 — 8/18 까지"   # 할 일 칸에 ☐ 로 뜬다
#   context-add --done "배포 반영"                     # 끝난 할 일을 지운다 (번호도 됨)
#   context-add --rm   "초안"                          # 핀·파일 줄을 지운다 (번호도 됨)
#   context-add --set  "이것만 남긴다"                 # replaces everything
#   context-add                                        # print current list (번호와 함께)
#   context-add --clear
set -euo pipefail

session="${CLAUDE_CODE_SESSION_ID:-}"
if [[ -z "$session" ]]; then
    echo "CLAUDE_CODE_SESSION_ID 가 없습니다 — Claude Code 세션 안에서 실행하세요." >&2
    exit 1
fi

dir="$HOME/.claude/tasks/$session"
mkdir -p "$dir"
file="$dir/.panel-context"

usage() {
    sed -n '2,12p' "$0" | sed 's/^#\{1,\} \{0,1\}//'
}

# One invocation writes one line. Passing several action flags at once used to
# concatenate them into a single unreadable entry.
reject_extra_flags() {
    local a
    for a in "$@"; do
        case "$a" in
            --todo|--add|--set|--done|--rm|--clear|--help)
                echo "한 번에 한 항목만 넣습니다 — '$a' 는 따로 실행하세요." >&2
                exit 1
                ;;
        esac
    done
}

# Delete one line, addressed by its listing number or by a substring.
# Refuses to guess: no match and ambiguous match are both errors.
remove_line() {
    local kind="$1" target="$2" label verb matches n
    [[ -s "$file" ]] || { echo "컨텍스트가 비어 있습니다." >&2; exit 1; }
    case "$kind" in
        todo) label="할 일"; verb="완료"; matches=$(grep -n '^[[:space:]]*todo:' "$file" || true) ;;
        line) label="컨텍스트"; verb="삭제"; matches=$(grep -n '' "$file" || true) ;;
    esac
    if [[ "$target" =~ ^[0-9]+$ ]]; then
        matches=$(printf '%s\n' "$matches" | awk -F: -v n="$target" '$1==n')
    else
        matches=$(printf '%s\n' "$matches" | grep -F -- "$target" || true)
    fi
    matches=$(printf '%s\n' "$matches" | sed '/^$/d')
    n=$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')
    if [[ "$n" -eq 0 ]]; then
        echo "찾지 못했습니다: '$target' ($label)" >&2
        exit 1
    fi
    if [[ "$n" -gt 1 ]]; then
        echo "'$target' 이 $n 개에 걸립니다 — 번호로 지정하세요:" >&2
        printf '%s\n' "$matches" | sed 's/^/  /' >&2
        exit 1
    fi
    local lineno text
    lineno=${matches%%:*}
    text=${matches#*:}
    sed -i.bak "${lineno}d" "$file" && rm -f "$file.bak"
    echo "${label} ${verb}: ${text#todo: }"
}

if [[ "${1:-}" == "--clear" ]]; then
    rm -f "$file"
    echo "컨텍스트 지움"
    exit 0
fi

if [[ $# -eq 0 ]]; then
    if [[ -s "$file" ]]; then
        grep -n '' "$file" | sed 's/^\([0-9]\{1,\}\):/\1  /'
    else
        echo "(컨텍스트 없음)"
    fi
    exit 0
fi

case "${1:-}" in
    --help|-h)
        usage
        ;;
    --todo)
        shift; reject_extra_flags "$@"
        printf 'todo: %s\n' "$*" >> "$file"
        echo "할 일: $*"
        ;;
    --done)
        shift; reject_extra_flags "$@"
        remove_line todo "$*"
        ;;
    --rm)
        shift; reject_extra_flags "$@"
        remove_line line "$*"
        ;;
    --set)
        shift; reject_extra_flags "$@"
        printf '%s\n' "$*" > "$file"
        echo "컨텍스트(교체): $*"
        ;;
    --add)
        shift; reject_extra_flags "$@"
        printf '%s\n' "$*" >> "$file"
        echo "컨텍스트: $*"
        ;;
    --*)
        echo "모르는 옵션: $1" >&2
        usage >&2
        exit 1
        ;;
    *)
        reject_extra_flags "$@"
        printf '%s\n' "$*" >> "$file"
        echo "컨텍스트: $*"
        ;;
esac
